{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(msvc) Attach",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    },
    {
      "name": "Launch BatmanAK.exe",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "D:\\SteamLibrary\\steamapps\\common\\Batman Arkham Knight\\Binaries\\Win64\\BatmanAK.exe",
      "cwd": "D:\\SteamLibrary\\steamapps\\common\\Batman Arkham Knight\\Binaries\\Win64",
      "args": ["-windowed", "-nosplash", "-nologo"],
      "symbolSearchPath": "${workspaceFolder}\\build\\Debug",
      "preLaunchTask": "Build & Link batmanak-rend2",
      "console": "internalConsole"
    },
    {
      "name": "Deploy Early Access",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/scripts/deploy-early-access.ps1",
      "cwd": "${cwd}",
      "args": [
        "--target", "${command:cmake.buildTargetName}",
        "--description", "\"${input:deployDescription}\""
      ],
    },
  ],
  "inputs": [
    {
      "id": "deployDescription",
      "type": "promptString",
      "description": "Deploy description (optional)",
      "default": ""
    }
  ]
}